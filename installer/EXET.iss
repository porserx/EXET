#define MyAppName "EXET"
#define MyAppVersion "1.1.0"
#define MyAppPublisher "EXET"
#define MyAppExeName "EXET.exe"

[Setup]
AppId={{7B2E6A1C-2F3D-4A8B-9C1E-7A1B2C3D4E5F}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\EXET Browser
DefaultGroupName=EXET
DisableProgramGroupPage=yes
PrivilegesRequired=admin
OutputDir=.
OutputBaseFilename=EXET-Setup-{#MyAppVersion}
Compression=lzma2/fast
SolidCompression=yes
WizardStyle=modern
WizardImageFile=wizard-large.bmp
WizardSmallImageFile=wizard-small.bmp
WizardImageStretch=yes
SetupIconFile=..\EXET\Assets\icon.ico
UninstallDisplayIcon={app}\{#MyAppExeName}
UninstallDisplayName={#MyAppName} {#MyAppVersion}
AppComments=轻量、原生、干净的 Windows 浏览器
VersionInfoDescription={#MyAppName} 安装程序
VersionInfoProductName={#MyAppName}
VersionInfoCompany={#MyAppPublisher}
VersionInfoVersion={#MyAppVersion}.0
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
SetupLogging=yes

[Languages]
Name: "chinesesimp"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
SetupAppTitle=EXET 安装程序
SetupWindowTitle=安装 EXET {#MyAppVersion}
WelcomeLabel1=欢迎安装 EXET
WelcomeLabel2=EXET 是一款轻量、原生、干净的 Windows 浏览器。%n%n安装程序将把 EXET 安装到你的电脑，并创建开始菜单快捷方式。%n%n点击“下一步”继续。
SelectDirLabel3=安装程序将把 EXET 安装到以下文件夹。
SelectDirBrowseLabel=点击“下一步”继续；如需选择其他文件夹，点击“浏览”。
ReadyLabel1=EXET 已准备好安装。
ReadyLabel2a=点击“安装”开始安装，或点击“上一步”检查设置。
FinishedHeadingLabel=EXET 安装完成
FinishedLabel=EXET 已成功安装。点击“完成”关闭安装程序，也可以直接启动 EXET。
ClickFinish=点击“完成”关闭安装程序。

[Tasks]
Name: "desktopicon"; Description: "创建桌面快捷方式"; GroupDescription: "附加任务:"; Flags: unchecked

[Code]
function InitializeSetup(): Boolean;
var
  ResultCode: Integer;
begin
  Result := True;
  if IsAdmin then
    exit;

  // Fallback for launchers that strip the requestedExecutionLevel manifest.
  // The normal path is still the admin manifest generated by Inno Setup.
  if ShellExec('runas', ExpandConstant('{srcexe}'), '', '', SW_SHOW,
    ewWaitUntilTerminated, ResultCode) then
  begin
    Result := False;
    exit;
  end;

  MsgBox('EXET 安装程序需要管理员权限。请右键选择“以管理员身份运行”。',
    mbError, MB_OK);
  Result := False;
end;

[Files]
Source: "..\EXET\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\MicrosoftEdgeWebView2RuntimeInstallerX64.exe"; DestDir: "{tmp}"; Flags: deleteafterinstall

[Icons]
Name: "{group}\EXET"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\EXET"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{tmp}\MicrosoftEdgeWebView2RuntimeInstallerX64.exe"; Parameters: "/silent /install"; StatusMsg: "正在安装 Microsoft Edge WebView2 运行时..."; Flags: waituntilterminated
Filename: "{app}\{#MyAppExeName}"; Description: "启动 EXET"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: "{cmd}"; Parameters: "/c taskkill /f /im {#MyAppExeName} >nul 2>&1"; Flags: runhidden; RunOnceId: "KillEXET"


