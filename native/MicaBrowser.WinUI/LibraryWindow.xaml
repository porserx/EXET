<Window
    x:Class="MicaBrowser.LibraryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MicaBrowser.Models">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header">
            <Border x:Name="DragRegion" Background="Transparent" />
            <TextBlock x:Name="TitleText"
                       Margin="20,0,0,0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,146,0"
                        Spacing="4">
                <Button x:Name="SidebarButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="在侧栏打开">
                    <FontIcon Glyph="&#xE8A0;" FontSize="14" />
                </Button>
                <Button x:Name="SettingsButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="打开设置">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <Button x:Name="CloseButton" Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="ContentHost" Grid.Row="1" Padding="18,4,18,18" />
    </Grid>
</Window>
