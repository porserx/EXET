<Application
    x:Class="MicaBrowser.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MicaBrowser.Models">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <StaticResource x:Key="ComboBoxItemBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground"
                             Color="{ThemeResource SystemChromeMediumColor}"
                             Opacity="0.52" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush"
                             Color="{ThemeResource SystemChromeMediumColor}"
                             Opacity="0.5" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground"
                             Color="{ThemeResource SystemChromeMediumColor}"
                             Opacity="0.62" />
            <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="BodyFontFamily">Microsoft YaHei UI</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            </Style>

            <Color x:Key="SystemAccentColor">#1F70B8</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1F70B8" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E61F70B8" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B31F70B8" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#331F70B8" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#1F70B8" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#C81F70B8" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#991F70B8" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#1F70B8" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#1F70B8" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#1F70B8" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#1F70B8" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#E61F70B8" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#B31F70B8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#1F70B8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#E61F70B8" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#B31F70B8" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#1F70B8" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="#1F70B8" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="#1F70B8" />

            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{ThemeResource IconFontFamily}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <Style x:Key="TabCloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{ThemeResource IconFontFamily}" />
                <Setter Property="FontSize" Value="10" />
            </Style>

            <Style x:Key="MaterialFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MaxWidth" Value="360" />
            </Style>

            <Style x:Key="MaterialMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="6" />
            </Style>

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HorizontalTabItemStyle" TargetType="ListViewItem">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="4,4,0,4" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="VerticalTabItemStyle" TargetType="ListViewItem">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="Padding" Value="8,0,0,0" />
                <Setter Property="Margin" Value="0,2,0,2" />
                <Setter Property="Height" Value="38" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="VerticalTabIconItemStyle" TargetType="ListViewItem">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,2,0,2" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="38" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
