<Window
    x:Class="MicaBrowser.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MicaBrowser.Models"
    Title="设置 - EXET">

    <Grid x:Name="RootGrid" Background="Transparent" UseLayoutRounding="True">
        <Grid.Resources>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground"
                             Color="{ThemeResource SystemChromeMediumColor}"
                             Opacity="0.84" />
            <SolidColorBrush x:Key="ComboBoxItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="Transparent" />
        </Grid.Resources>
        <Border x:Name="MicaFallbackBorder"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="48" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="CaptionSpacerColumn" Width="140" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="TitleBarDragArea" Grid.Column="0" Background="Transparent">
                    <Button x:Name="SettingsNavToggleButton"
                            Width="36" Height="36" Padding="0"
                            Margin="12,0,0,0"
                            Background="Transparent" BorderThickness="0" CornerRadius="8"
                            HorizontalAlignment="Left"
                            Click="SettingsNavToggle_Click"
                            ToolTipService.ToolTip="折叠或展开设置导航">
                        <FontIcon Glyph="&#xE700;" FontSize="15" FontFamily="{ThemeResource IconFontFamily}" />
                    </Button>
                    <TextBlock Text="设置"
                               Margin="56,0,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Grid>
                <Grid Grid.Column="1" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsNavColumn" Width="224" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SettingsNavPane"
                        Grid.Column="0"
                        Width="224"
                        Background="Transparent"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0"
                        SizeChanged="SettingsNavPane_SizeChanged">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SettingsNavTransform" />
                    </Border.RenderTransform>
                    <StackPanel x:Name="SettingsNavRoot" Margin="14,18,14,14" Spacing="6">
                        <StackPanel x:Name="SettingsNavHeader" Orientation="Horizontal" Spacing="9" Margin="8,0,0,18">
                            <Image Source="Assets/logo.png" Width="26" Height="26" Stretch="Uniform" />
                            <TextBlock x:Name="SettingsNavHeaderText" Text="EXET"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>

                        <ListView x:Name="SettingsNav"
                                  SelectionMode="Single"
                                  SelectionChanged="SettingsNav_SelectionChanged"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0">
                            <ListViewItem Tag="general">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    <TextBlock Text="常规" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="favorites">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE728;" FontSize="14" />
                                    <TextBlock Text="收藏夹管理" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="history">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE81C;" FontSize="14" />
                                    <TextBlock Text="历史记录" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="downloads">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="下载管理" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="appearance">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" />
                                    <TextBlock Text="外观" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="adguard">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE730;" FontSize="14" />
                                    <TextBlock Text="广告拦截" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="privacy">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                    <TextBlock Text="隐私与安全" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="passwords">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE192;" FontSize="14" />
                                    <TextBlock Text="密码管理器" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="extensions">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PathIcon Width="14" Height="14"
                                              Data="M2,2 L7,2 L7,7 L2,7 Z M9,2 L14,2 L14,7 L9,7 Z M2,9 L7,9 L7,14 L2,14 Z M9,9 L14,9 L14,14 L9,14 Z" />
                                    <TextBlock Text="扩展" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="about">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" />
                                    <TextBlock Text="关于" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>


                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" Padding="44,26,44,44" Background="Transparent" VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="840" HorizontalAlignment="Left" Background="Transparent">

                        <StackPanel x:Name="GeneralSection" Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="浏览器的基础行为和布局。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <Grid RowSpacing="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="默认搜索引擎" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="在地址栏输入关键词时，用这个搜索引擎查找。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="SearchEngineCombo"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="SearchEngineCombo_SelectionChanged">
                                            <ComboBoxItem Content="Bing" Tag="Bing" />
                                            <ComboBoxItem Content="百度" Tag="Baidu" />
                                            <ComboBoxItem Content="Google" Tag="Google" />
                                            <ComboBoxItem Content="DuckDuckGo" Tag="DuckDuckGo" />
                                            <ComboBoxItem Content="搜狗" Tag="Sogou" />
                                            <ComboBoxItem Content="Yandex" Tag="Yandex" />
                                            <ComboBoxItem Content="自定义" Tag="Custom" />
                                        </ComboBox>
                                    </Grid>

                                    <StackPanel x:Name="CustomSearchSettings"
                                                Grid.Row="1"
                                                Grid.RowSpan="2"
                                                Spacing="8"
                                                Visibility="Collapsed">
                                        <TextBox x:Name="CustomSearchUrlBox"
                                                 Header="搜索 URL（用 {query} 代表关键词）"
                                                 PlaceholderText="https://example.com/search?q={query}"
                                                 FontSize="13" />
                                        <Button Content="保存自定义搜索引擎"
                                                HorizontalAlignment="Left"
                                                Click="SaveCustomSearch_Click" />
                                    </StackPanel>

                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="默认主页" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="新标签页和主页按钮会打开它。默认是 Litestart。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="HomePageBox"
                                                 PlaceholderText="https://xingyuefox.github.io/Litestart/"
                                                 FontSize="13" />
                                        <Button Grid.Column="1" Content="保存主页设置"
                                                Click="SaveHomePage_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="启动行为" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="没有恢复标签页时，启动后先打开新标签页还是主页。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox x:Name="StartupBehaviorCombo"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="StartupBehaviorCombo_SelectionChanged">
                                        <ComboBoxItem Content="打开新标签页" Tag="NewTab" />
                                        <ComboBoxItem Content="打开主页" Tag="HomePage" />
                                    </ComboBox>

                                    <Grid ColumnSpacing="18" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="关闭后重新打开时恢复标签页" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="关闭窗口时保存标签，下次打开自动恢复。默认关闭。"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="RestoreTabsSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="RestoreTabsSwitch_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="标签与性能" FontSize="14" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="垂直标签页" FontSize="13" />
                                            <TextBlock Text="在左侧显示标签页列表。" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="VerticalTabsSwitch" Grid.Column="1"
                                                      OnContent="已开启" OffContent="已关闭"
                                                      Toggled="VerticalTabsSwitch_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="垂直标签栏宽度" FontSize="13" />
                                            <TextBlock Text="调整左侧标签栏宽度；仅影响显示完整标题的模式。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <Slider x:Name="VerticalTabWidthSlider"
                                                    Minimum="180" Maximum="420"
                                                    StepFrequency="10"
                                                    ValueChanged="VerticalTabWidthSlider_ValueChanged" />
                                            <TextBlock x:Name="VerticalTabWidthText" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="垂直标签仅显示图标" FontSize="13" />
                                            <TextBlock Text="收起垂直标签栏，仅保留站点图标。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="VerticalIconsOnlySwitch" Grid.Column="1"
                                                      OnContent="图标" OffContent="完整"
                                                      Toggled="VerticalIconsOnlySwitch_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="后台标签页休眠" FontSize="13" />
                                            <TextBlock Text="暂时不用的标签页会释放内存，切回来时自动恢复。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="SuspendTabsSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="SuspendTabsSwitch_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="界面语言" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="选择 EXET 的界面语言。更改后重新打开浏览器生效。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <ComboBox x:Name="LanguageCombo"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="LanguageCombo_SelectionChanged">
                                        <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                        <ComboBoxItem Content="English" Tag="en-US" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <StackPanel x:Name="FavoritesSection" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="收藏夹管理" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="默认收藏夹、数据清理和收藏夹行为。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="收藏夹" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="收藏网页时先保存到默认收藏夹，随后可以在弹出的小窗口中更改或新建收藏夹。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <Grid ColumnSpacing="8" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DefaultFavoriteFolderBox"
                                                 Header="默认收藏夹" FontSize="13" />
                                        <Button Grid.Column="1" Content="保存"
                                                VerticalAlignment="Bottom"
                                                Click="SaveDefaultFavoriteFolder_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="8" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewFavoriteFolderBox"
                                                 Header="新建收藏夹分类"
                                                 FontSize="13"
                                                 PlaceholderText="例如：学习资料" />
                                        <Button Grid.Column="1" Content="新建分类"
                                                VerticalAlignment="Bottom"
                                                Click="CreateFavoriteFolder_Click" />
                                    </Grid>
                                    <TextBlock x:Name="FavoriteFoldersHint" Visibility="Collapsed"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="收藏内容" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="新建文件夹"
                                                Click="NewFavoriteFolder_Click" />
                                    </Grid>
                                    <TextBlock Text="点击文件夹查看其中的收藏网页。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <ListView x:Name="FavoriteFoldersList"
                                              ItemsSource="{x:Bind FavoriteFolders}"
                                              SelectionMode="Single"
                                              SelectionChanged="FavoriteFoldersList_SelectionChanged"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              MaxHeight="280">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="42" ColumnSpacing="10">
                                                    <Grid.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="重命名" Tag="{Binding}" Click="RenameFavoriteFolder_Click" />
                                                            <MenuFlyoutItem Text="删除文件夹" Tag="{Binding}" Click="DeleteFavoriteFolder_Click" />
                                                        </MenuFlyout>
                                                    </Grid.ContextFlyout>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                                              VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <Button Grid.Column="2"
                                                            Width="28" Height="28" Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Tag="{Binding}"
                                                            Click="DeleteFavoriteFolder_Click"
                                                            ToolTipService.ToolTip="删除文件夹">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" FontFamily="{ThemeResource IconFontFamily}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid x:Name="FavoriteFolderItemsHeader"
                                          Visibility="Collapsed"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="返回分类"
                                                Click="FavoriteFolderBack_Click" />
                                        <TextBlock x:Name="CurrentFavoriteFolderText"
                                                   Grid.Column="1"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <ListView x:Name="SettingsFavoritesList"
                                              ItemsSource="{x:Bind FavoriteFolderItems}"
                                              Visibility="Collapsed"
                                              SelectionMode="None"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              MaxHeight="280"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:FavoriteEntry">
                                                <Grid Height="42" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE728;" FontSize="13"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Url}" FontSize="10"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Visibility="Collapsed"
                                                            Content="{x:Bind Folder, Mode=OneWay}"
                                                            Tag="{x:Bind Url}"
                                                            FontSize="11"
                                                            Padding="6,2"
                                                            MinWidth="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            Click="ChangeFavoriteFolder_Click"
                                                            ToolTipService.ToolTip="更改收藏夹分类" />
                                                    <Button Grid.Column="3" Width="26" Height="26" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            Tag="{x:Bind Url}" Click="EditFavoriteSettings_Click"
                                                            ToolTipService.ToolTip="编辑收藏">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="11" FontFamily="{ThemeResource IconFontFamily}" />
                                                    </Button>
                                                    <Button Grid.Column="4" Width="26" Height="26" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            Tag="{x:Bind Url}" Click="DeleteFavoriteSettings_Click"
                                                            ToolTipService.ToolTip="删除收藏">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" FontFamily="{ThemeResource IconFontFamily}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="数据管理" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="清除历史记录和收藏夹数据。操作无法撤销。"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="清除全部浏览历史"
                                                Click="ClearHistorySettings_Click" />
                                        <Button Content="清除全部收藏"
                                                Click="ClearFavoritesSettings_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="HistorySection" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="历史记录" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="查看和管理最近浏览过的网页"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="最近浏览" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock x:Name="HistoryEmptyText" Text="还没有浏览记录"
                                                       Visibility="Collapsed"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="清除全部历史"
                                                VerticalAlignment="Center"
                                                Click="ClearHistorySettings_Click" />
                                    </Grid>
                                    <StackPanel x:Name="SettingsHistoryGrouped" Grid.Row="1" Spacing="2" />

                                    <ListView x:Name="SettingsHistoryList" Grid.Row="1" Visibility="Collapsed"
                                              ItemsSource="{x:Bind History}"
                                              SelectionMode="None"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              MaxHeight="430"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:HistoryEntry">
                                                <Grid Height="50" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="4,2"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Tag="{x:Bind Url}"
                                                            Click="HistorySettingsOpen_Click">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{x:Bind Title}" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{x:Bind Host}" FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind VisitedText}" FontSize="11"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Width="30" Height="30" Padding="0"
                                                            Style="{StaticResource TabCloseButtonStyle}"
                                                            Tag="{x:Bind Url}"
                                                            Click="RemoveHistorySettings_Click"
                                                            ToolTipService.ToolTip="删除记录">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11"
                                                                  FontFamily="{ThemeResource IconFontFamily}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="DownloadsSection" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="下载管理" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="默认下载目录与下载前保存位置设置。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="下载" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="设置默认下载目录，或让每次下载都先询问保存位置。"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DownloadFolderBox"
                                                 Header="下载位置（留空使用系统下载文件夹）"
                                                 PlaceholderText="%USERPROFILE%\Downloads"
                                                 FontSize="13" />
                                        <Button Grid.Column="1" Content="选择文件夹…"
                                                VerticalAlignment="Bottom"
                                                Click="ChooseDownloadFolder_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="下载前询问保存位置" FontSize="13" />
                                            <TextBlock Text="每次下载都弹出 Windows 保存对话框。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AskWhereToSaveSwitch" Grid.Column="1"
                                                      OnContent="询问" OffContent="直接保存" />
                                    </Grid>
                                    <Button Content="保存下载设置" HorizontalAlignment="Left"
                                            Click="SaveDownloadSettings_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="下载记录" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="这里会列出本次运行中开始下载的文件。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <ListView x:Name="SettingsDownloadsList"
                                              ItemsSource="{x:Bind Downloads}"
                                              SelectionMode="None"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0"
                                              MaxHeight="280"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:DownloadItem">
                                                <Grid Height="42" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE896;" FontSize="13"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind State, Mode=OneWay}" FontSize="10"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <StackPanel x:Name="PrivacySection" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="隐私与安全" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="控制网站能不能跟踪你、使用权限，以及网页是否跟随夜间模式。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="隐私与安全" FontSize="14" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="发送 Do Not Track 请求" FontSize="13" />
                                            <TextBlock Text="向网站请求不要进行跨站跟踪。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DoNotTrackSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="PrivacyToggle_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="阻止第三方跟踪器" FontSize="13" />
                                            <TextBlock Text="拦截常见统计、广告和跨站跟踪域名。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="BlockTrackersSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="PrivacyToggle_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="增强网页夜间模式" FontSize="13" />
                                            <TextBlock Text="对未适配深色模式的网页强制使用深色样式，部分图片可能被反色。"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ForceDarkPagesSwitch" Grid.Column="1"
                                                      OnContent="增强" OffContent="跟随网站"
                                                      Toggled="PrivacyToggle_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="禁用 JavaScript" FontSize="13" />
                                            <TextBlock Text="阻止网页脚本运行，能减少追踪但可能影响网站功能。"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DisableJavaScriptSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="PrivacyToggle_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="阻止自动填充" FontSize="13" />
                                            <TextBlock Text="关闭表单自动填充、地址和密码自动保存提示。"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="BlockAutofillSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="PrivacyToggle_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="退出时清除 Cookie" FontSize="13" />
                                            <TextBlock Text="关闭浏览器后清除网站 Cookie 和登录状态。"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ClearCookiesOnExitSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="PrivacyToggle_Toggled" />
                                    </Grid>
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="自动拒绝敏感权限" FontSize="13" />
                                            <TextBlock Text="摄像头、麦克风、定位和通知请求直接拒绝，不再弹窗。"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DenySensitivePermissionsSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="PrivacyToggle_Toggled" />
                                    </Grid>
                                    <Button Content="清除网站权限决定" HorizontalAlignment="Left"
                                            Click="ClearPermissionRules_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AppearanceSection" Spacing="18" Visibility="Collapsed">

                            <StackPanel Spacing="4">
                                <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="选择外观、材质、颜色和动画速度。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <Grid RowSpacing="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="ThemeModeRow" Grid.Row="0" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="应用主题" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="选择浏览器的浅色或深色外观，也可以跟随 Windows。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="ThemeModeCombo"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="ThemeModeCombo_SelectionChanged">
                                            <ComboBoxItem Content="跟随系统" Tag="System" />
                                            <ComboBoxItem Content="浅色" Tag="Light" />
                                            <ComboBoxItem Content="深色" Tag="Dark" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="夜间模式" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="让网页也使用深色显示，适合晚上使用。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="NightModeSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="NightModeSwitch_Toggled" />
                                    </Grid>

                                    <Grid Grid.Row="2" ColumnSpacing="18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="界面材质" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="选择窗口的模糊、玻璃或彩色效果，不同材质的可读性不同。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="MicaMaterialCombo"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="MicaMaterialCombo_SelectionChanged">
                                            <ComboBoxItem Content="云母" Tag="Mica" />
                                            <ComboBoxItem Content="云母 Alt" Tag="Alt" />
                                            <ComboBoxItem Content="亚克力" Tag="Acrylic" />
                                            <ComboBoxItem Content="细亚克力" Tag="AcrylicThin" />
                                        </ComboBox>

                                        

                                        <StackPanel x:Name="AcrylicColorPanel" Visibility="Collapsed"
                                                    Grid.Row="1"
                                                    Grid.ColumnSpan="2"
                                                    Margin="0,10,0,0"
                                                    Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="Acrylic 自定义颜色"
                                                           FontSize="13"
                                                           VerticalAlignment="Center" />
                                                <TextBox x:Name="AcrylicColorBox"
                                                         Width="130"
                                                         FontSize="13"
                                                         PlaceholderText="#1F70B8"
                                                         TextChanged="AcrylicColorBox_TextChanged" />
                                                <Border x:Name="AcrylicColorPreview"
                                                        Width="34"
                                                        Height="26"
                                                        CornerRadius="5"
                                                        Background="#1F70B8"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center" />
                                                <Button x:Name="AcrylicPaletteButton"
                                                        Content="调色盘…"
                                                        FontSize="12"
                                                        Padding="12,4"
                                                        VerticalAlignment="Center">
                                                    <Button.Flyout>
                                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                                            <ColorPicker x:Name="AcrylicColorPicker"
                                                                         IsAlphaEnabled="False"
                                                                         IsColorChannelTextInputVisible="True"
                                                                         ColorChanged="AcrylicColorPicker_ColorChanged" />
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Tag="#1F70B8" Click="AcrylicSwatch_Click" Width="24" Height="24" Padding="0" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="#1F70B8" ToolTipService.ToolTip="标志蓝" />
                                                <Button Tag="#6B4DE6" Click="AcrylicSwatch_Click" Width="24" Height="24" Padding="0" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="#6B4DE6" ToolTipService.ToolTip="紫" />
                                                <Button Tag="#2F6BFF" Click="AcrylicSwatch_Click" Width="24" Height="24" Padding="0" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="#2F6BFF" ToolTipService.ToolTip="蓝" />
                                                <Button Tag="#008C95" Click="AcrylicSwatch_Click" Width="24" Height="24" Padding="0" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="#008C95" ToolTipService.ToolTip="青" />
                                                <Button Tag="#2E8B57" Click="AcrylicSwatch_Click" Width="24" Height="24" Padding="0" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="#2E8B57" ToolTipService.ToolTip="绿" />
                                                <Button Tag="#D97706" Click="AcrylicSwatch_Click" Width="24" Height="24" Padding="0" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="#D97706" ToolTipService.ToolTip="橙" />
                                                <Button Tag="#C2413B" Click="AcrylicSwatch_Click" Width="24" Height="24" Padding="0" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="#C2413B" ToolTipService.ToolTip="红" />
                                                <Button Tag="#C0397A" Click="AcrylicSwatch_Click" Width="24" Height="24" Padding="0" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="#C0397A" ToolTipService.ToolTip="粉" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Grid x:Name="TransparencyRow" Grid.Row="3" ColumnSpacing="18" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="TransparencyTitle" Text="背景透明度" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TransparencyHint" Text="数值越大，背景越透明；Blur 固定使用更清晰的不透明度。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <Slider x:Name="TransparencySlider"
                                                    Minimum="0" Maximum="100"
                                                    StepFrequency="1"
                                                    ValueChanged="TransparencySlider_ValueChanged" />
                                            <TextBlock x:Name="TransparencyValueText" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="主题色" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="按钮、选中标签和强调文字使用的颜色。"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ComboBox x:Name="AccentCombo"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="AccentCombo_SelectionChanged">
                                            <ComboBoxItem Content="标志蓝" Tag="#1F70B8" />
                                            <ComboBoxItem Content="紫色" Tag="#6B4DE6" />
                                            <ComboBoxItem Content="蓝色" Tag="#2F6BFF" />
                                            <ComboBoxItem Content="青色" Tag="#008C95" />
                                            <ComboBoxItem Content="绿色" Tag="#2E8B57" />
                                            <ComboBoxItem Content="橙色" Tag="#D97706" />
                                            <ComboBoxItem Content="红色" Tag="#C2413B" />
                                            <ComboBoxItem Content="粉色" Tag="#C0397A" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid Grid.Row="5" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="260" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="界面动画速度" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="数字越大动画越慢；0 表示关闭动画。"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <Slider x:Name="AnimationSpeedSlider"
                                                    Minimum="0" Maximum="1600"
                                                    StepFrequency="10"
                                                    ValueChanged="AnimationSpeedSlider_ValueChanged" />
                                            <TextBlock x:Name="AnimationSpeedText" FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="6" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="启动遮罩动画" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="开启后启动时先播放 1.2 秒遮罩，再显示浏览器界面。"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="StartupMaskSwitch" Grid.Column="1"
                                                      OnContent="开启" OffContent="关闭"
                                                      Toggled="StartupMaskSwitch_Toggled" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="半透明窗口" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="系统在关闭透明效果、节电模式或硬件不支持时会自动改用纯色背景，这是 Windows 的行为。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        

<Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="工具栏按钮" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="勾选要显示的按钮；隐藏的按钮会收进左侧展开菜单。"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <CheckBox x:Name="ShowHomeButtonCheck" Content="主页" Tag="ShowHomeButton" Click="ToolbarButtonToggle_Click" />
                                        <CheckBox x:Name="ShowFavoriteButtonCheck" Content="收藏当前页" Tag="ShowFavoriteButton" Click="ToolbarButtonToggle_Click" />
                                        <CheckBox x:Name="ShowShieldButtonCheck" Content="广告拦截" Tag="ShowShieldButton" Click="ToolbarButtonToggle_Click" />
                                        <CheckBox x:Name="ShowPasswordsButtonCheck" Content="密码" Tag="ShowPasswordsButton" Click="ToolbarButtonToggle_Click" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <CheckBox x:Name="ShowFavoritesButtonCheck" Content="收藏夹" Tag="ShowFavoritesButton" Click="ToolbarButtonToggle_Click" />
                                        <CheckBox x:Name="ShowExtensionsButtonCheck" Content="扩展" Tag="ShowExtensionsButton" Click="ToolbarButtonToggle_Click" />
                                        <CheckBox x:Name="ShowDownloadsButtonCheck" Content="下载" Tag="ShowDownloadsButton" Click="ToolbarButtonToggle_Click" />
                                        <CheckBox x:Name="ShowHistoryButtonCheck" Content="历史记录" Tag="ShowHistoryButton" Click="ToolbarButtonToggle_Click" />
                                    </StackPanel>
                                    <TextBlock Text="按钮顺序" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <StackPanel x:Name="ToolbarOrderPanel" Spacing="4" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="界面字体" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="默认使用 MiSans；也可输入已安装的字体名称。"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <ComboBox x:Name="UiFontCombo"
                                                  HorizontalAlignment="Stretch"
                                                  IsEditable="True"
                                                  PlaceholderText="MiSans"
                                                  SelectionChanged="UiFontCombo_SelectionChanged"
                                                  LostFocus="UiFontCombo_LostFocus"
                                                  KeyDown="UiFontCombo_KeyDown">
                                            <ComboBoxItem Content="MiSans 默认" Tag="MiSans" />
                                                                                        <ComboBoxItem Content="微软雅黑" Tag="Microsoft YaHei UI" />
                                            <ComboBoxItem Content="等线" Tag="DengXian" />
                                            <ComboBoxItem Content="宋体" Tag="SimSun" />
                                            <ComboBoxItem Content="楷体" Tag="KaiTi" />
                                            <ComboBoxItem Content="Segoe UI Variable" Tag="Segoe UI Variable" />
                                        </ComboBox>
                                        <ComboBox x:Name="UiFontWeightCombo"
                                                  HorizontalAlignment="Stretch"
                                                  PlaceholderText="字体粗细"
                                                  SelectionChanged="UiFontWeightCombo_SelectionChanged">
                                            <ComboBoxItem Content="细体 300" Tag="300" />
                                            <ComboBoxItem Content="常规 400" Tag="400" />
                                            <ComboBoxItem Content="中等 500" Tag="500" />
                                            <ComboBoxItem Content="半粗 600" Tag="600" />
                                            <ComboBoxItem Content="粗体 700" Tag="700" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>
</StackPanel>

                        <StackPanel x:Name="AdGuardSection" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="广告拦截" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="在网页加载时挡住广告和跟踪脚本。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <Grid RowSpacing="18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="广告拦截" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="AdGuardStatusText" Text="已启用 · 请求级拦截"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AdGuardSwitch"
                                                      Grid.Column="1"
                                                      OnContent="已开启"
                                                      OffContent="已关闭"
                                                      Toggled="AdGuardSwitch_Toggled" />
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" Padding="16">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="累计拦截" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock x:Name="AdGuardTotalText" Text="0" FontSize="24" FontWeight="Light" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" Padding="16">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="域名规则" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock x:Name="AdGuardDomainText" Text="0" FontSize="24" FontWeight="Light" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" Padding="16">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="路径规则" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock x:Name="AdGuardPathText" Text="0" FontSize="24" FontWeight="Light" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="AdGuardRulesText" Text="过滤规则" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock x:Name="AdGuardRuleSummaryText" Text=""
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                        <Button x:Name="UpdateFiltersButton"
                                                Grid.Column="1"
                                                Content="更新过滤规则"
                                                Click="UpdateFiltersButton_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="已暂停过滤的网站" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AllowlistText" Text="当前没有暂停过滤的网站。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <StackPanel x:Name="PasswordsSection" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="密码管理器" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="保存网站账号，打开对应网站时可以自动填入。密码只保存在当前 Windows 用户下。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="自动填充登录信息" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="打开已保存过密码的网站时，自动填入用户名和密码，不会自动提交。"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="PasswordAutofillSwitch" Grid.Column="1"
                                              OnContent="开启" OffContent="关闭"
                                              Toggled="PasswordAutofillSwitch_Toggled" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="添加密码" Click="AddPassword_Click" />
                                <Button Content="生成密码" Click="GeneratePassword_Click" />
                                <Button Content="刷新" Click="RefreshPasswords_Click" />
                            </StackPanel>

                            <TextBlock x:Name="PasswordsStatusText" Text=""
                                       Style="{StaticResource CaptionTextStyle}" />

                            <ListView x:Name="PasswordsList"
                                      ItemsSource="{x:Bind Passwords}"
                                      SelectionMode="None"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SavedLogin">
                                        <Border Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,0,0,8">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="9"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                    <FontIcon Glyph="&#xE192;" FontSize="16"
                                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Site}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Username}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind MaskedPassword}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="复制" Height="30" FontSize="12"
                                                        Tag="{x:Bind Id}" Click="CopyPassword_Click" />
                                                <Button Grid.Column="3" Content="编辑" Height="30" FontSize="12"
                                                        Tag="{x:Bind Id}" Click="EditPassword_Click" />
                                                <Button Grid.Column="4" Content="删除" Height="30" FontSize="12"
                                                        Tag="{x:Bind Id}" Click="DeletePassword_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="安全说明" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="密码不会以明文写入磁盘或日志；仅当前 Windows 用户可以解密。复制密码会写入系统剪贴板，请在使用后清除剪贴板。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="ExtensionsSection" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="扩展" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="加载本地扩展，并在普通标签页和窗口中生效。"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="加载解压扩展…" Click="LoadExtensionButton_Click" />
                                <Button Content="安装内置示例" Click="InstallSampleButton_Click" />
                                <Button Content="刷新" Click="RefreshExtensionsButton_Click" />
                                <Button Content="打开扩展目录" Click="OpenExtensionsFolderButton_Click" />
                            </StackPanel>

                            <TextBlock x:Name="ExtensionsStatusText" Text=""
                                       Style="{StaticResource CaptionTextStyle}" />

                            <ListView x:Name="ExtensionsList"
                                      SelectionMode="None"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ExtensionInfo">
                                        <Border Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,0,0,8">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="9"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                    <TextBlock Text="E" FontSize="17" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Id}" FontSize="10"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                                              Tag="{x:Bind Id}" Toggled="ExtensionToggle_Toggled"
                                                              OnContent="启用" OffContent="停用"
                                                              VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Width="32" Height="32" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Tag="{x:Bind Id}" Click="RemoveExtension_Click"
                                                        ToolTipService.ToolTip="移除扩展">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" FontFamily="{ThemeResource IconFontFamily}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="兼容性说明" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="支持加载本地未打包扩展，但不提供扩展商店一键安装，也不会显示扩展工具栏按钮或 popup。依赖内容脚本、后台脚本和页面样式注入的扩展可以正常工作。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutSection" Spacing="18" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" FontSize="28" />
                                <TextBlock Text="版本信息、运行环境和项目说明"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource SectionCardStyle}" Padding="24" CornerRadius="16">
                                <Grid ColumnSpacing="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="84" Height="84" CornerRadius="22"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                            VerticalAlignment="Top">
                                        <Image Source="Assets/logo.png" Width="68" Height="68"
                                               Stretch="Uniform" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="7">
                                        <TextBlock Text="EXET" FontSize="36" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="10" Padding="10,3">
                                                <TextBlock x:Name="AboutVersionText" Text="版本 1.0.12"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="10" Padding="10,3">
                                                <TextBlock Text="Windows 原生浏览器" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="作者：PorserX &amp; EXET Team"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button Content="设为默认浏览器"
                                                Click="SetDefaultBrowser_Click"
                                                Margin="0,4,0,0" />
                                        <TextBlock Text="窗口、标签、地址栏和设置由系统原生控件绘制，网页由内置 Chromium 内核显示。"
                                                   TextWrapping="Wrap" FontSize="14"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SectionCardStyle}" Padding="16" CornerRadius="12">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xE8A0;" FontSize="20"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="多标签 / 垂直标签" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock Text="水平、竖向与无痕模式" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Padding="16" CornerRadius="12">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xE774;" FontSize="20"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="WebView2 内核" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock Text="Chromium 网页渲染" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="16" CornerRadius="12">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xE790;" FontSize="20"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="原生界面" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock Text="Mica / Acrylic 材质" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource SectionCardStyle}" Padding="20" CornerRadius="12">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE946;" FontSize="18"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="软件宗旨" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="EXET 致力于以纯净、流畅、美观为设计目标，为用户提供一个舒适、让人安心的浏览器。"
                                                   TextWrapping="Wrap" LineHeight="23"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="本浏览器使用 DSH 辅助构建，保持开源，并坚持公益原则。"
                                                   TextWrapping="Wrap" LineHeight="23"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="目前项目处于早期阶段，使用中可能存在一些 Bug 或功能缺失。你可以在项目的 GitHub 上提交 Issue，我们会及时处理。"
                                                   TextWrapping="Wrap" LineHeight="23"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="在稳定之前，项目将力争每 7 天发布一个正式版本。"
                                                   TextWrapping="Wrap" LineHeight="23"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="这个版本能做什么" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="• 多标签、垂直标签、无痕模式"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="• 收藏、历史、下载和密码管理"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="• 广告拦截、扩展、网页缩放和 PDF 预览"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="• Acrylic、Blur、Smoke、炫彩等窗口材质"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="默认主页是第三方页面 Litestart，可在“常规 → 默认主页”改成任意网址。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="运行环境" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AboutRuntimeText" Text="网页内核：正在读取…"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="AboutOsText" Text="Windows：正在读取…"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="AboutDotNetText" Text=".NET：正在读取…"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="AboutDataText" Text="数据目录：正在读取…"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:Name="AboutAdBlockText" Text="广告过滤规则：正在读取…"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button Content="打开数据目录" Click="OpenDataFolder_Click" />
                                        <Button Content="复制环境信息" Click="CopyEnvironmentInfo_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="说明" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="EXET 不是 Microsoft Edge 或 Google Chrome 的发行版；网页内核使用 Microsoft Edge WebView2。广告过滤规则来自第三方规则列表，过滤效果取决于规则是否覆盖对应网站。"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>


