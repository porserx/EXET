                          IsTabStop="False"
                          IsItemClickEnabled="True"
                          ItemClick="AddressSuggestionsList_ItemClick"
                          MaxHeight="360"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="4"
                          FontFamily="Microsoft YaHei UI">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AddressSuggestion">
                            <Grid Height="42" ColumnSpacing="10" Padding="8,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        <Border x:Name="ScreenshotPreviewPanel"
                Width="340"
                Margin="0,96,18,0"
                Padding="14"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Visibility="Collapsed"
                Canvas.ZIndex="100">
            <StackPanel Spacing="10">
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock Text="网页截图" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="已截取当前网页，可保存到指定位置"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="28" Height="28"
                            Padding="0"
                            CornerRadius="8"
                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Click="CloseScreenshotPreview_Click"
                            ToolTipService.ToolTip="关闭">
                        <TextBlock Text="✕" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                </Grid>
                <Border CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image x:Name="ScreenshotPreviewImage"
                           Height="180"
                           Stretch="UniformToFill" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="关闭" Click="CloseScreenshotPreview_Click" />
                    <Button Content="保存到…" Style="{StaticResource AccentButtonStyle}"
                            Click="SaveScreenshot_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="NewPrivateTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusAddressAccelerator_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="ReloadAccelerator_Invoked" />
            <KeyboardAccelerator Key="D" Modifiers="Control" Invoked="FavoriteAccelerator_Invoked" />
            <KeyboardAccelerator Key="J" Modifiers="Control" Invoked="DownloadsAccelerator_Invoked" />
            <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="HistoryAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="ReloadAccelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="FullScreenAccelerator_Invoked" />
            <KeyboardAccelerator Key="F12" Invoked="DevToolsAccelerator_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SettingsAccelerator_Invoked" />
            <KeyboardAccelerator Key="M" Modifiers="Control,Shift" Invoked="TaskManagerAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>











