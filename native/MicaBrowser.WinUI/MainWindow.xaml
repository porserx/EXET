<Window
    x:Class="MicaBrowser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MicaBrowser.Models"
    xmlns:controls="using:MicaBrowser.Controls"
    Title="EXET">

    <Grid x:Name="RootGrid" Background="Transparent" UseLayoutRounding="True">
        <Border x:Name="MicaFallbackBorder"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed" />

        <Grid x:Name="WindowLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="WindowDragAnchor"
                  Width="1" Height="1"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Background="Transparent" />

            <!-- Main workspace: the vertical tab rail is in column 0. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="VerticalTabsColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="VerticalTabPane"
                        Grid.Column="0"
                        Width="260"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid x:Name="VerticalTabsLayoutGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="VerticalTabsHeaderGrid" Grid.Row="0" Padding="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VerticalTabsHeaderTitle"
                                       Text="标签页"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Button x:Name="VerticalTabLayoutHeaderButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Width="30" Height="30"
                                    Margin="0,0,2,0"
                                    Click="TabLayoutMenu_Click"
                                    ToolTipService.ToolTip="标签页布局和本次记录">
                                <FontIcon Glyph="&#xE70D;" FontSize="13" FontFamily="Segoe Fluent Icons" />
                            </Button>
                            <Button x:Name="VerticalNewTabHeaderButton"
                                    Grid.Column="2"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Width="30"
                                    Height="30"
                                    Click="NewTab_Click"
                                    ToolTipService.ToolTip="新建标签页">
                                <FontIcon Glyph="&#xE710;" FontSize="13" FontFamily="Segoe Fluent Icons" />
                            </Button>
                            <Button x:Name="VerticalTabsCollapseButton"
                                    Grid.Column="3"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Width="30"
                                    Height="30"
                                    Click="VerticalTabsCollapse_Click"
                                    ToolTipService.ToolTip="仅显示标签图标">
                                <FontIcon x:Name="VerticalTabsCollapseIcon" Glyph="&#xE76B;" FontSize="13" FontFamily="Segoe Fluent Icons" />
                            </Button>
                        </Grid>

                        <ListView x:Name="VerticalTabList"
                                  Grid.Row="1"
                                  ItemsSource="{x:Bind Tabs}"
                                  SelectionMode="Single"
                                  UseSystemFocusVisuals="False"
                                  IsItemClickEnabled="True"
                                  SelectionChanged="VerticalTabList_SelectionChanged"
                                  ItemClick="VerticalTabList_ItemClick"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="0"
                                  ItemContainerStyle="{StaticResource VerticalTabItemStyle}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemFocusVisualPrimaryBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemFocusVisualSecondaryBrush" Color="Transparent" />
                                <DataTemplate x:Key="VerticalIconTabTemplate" x:DataType="models:BrowserTab">
                                    <Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{x:Bind TabOpacity, Mode=OneWay}">
                                        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"
                                                    Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Initial, Mode=OneWay}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{x:Bind Favicon, Mode=OneWay}"
                                                   Width="16" Height="16" Stretch="Uniform"
                                                   Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                            <ProgressRing Width="16" Height="16"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                          IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                                          Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                                            <Button Width="18" Height="18"
                                                    MinWidth="0" MinHeight="0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="TabAudioButton_Click"
                                                    Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                    ToolTipService.ToolTip="静音/取消静音">
                                                <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}"
                                                          FontSize="11"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:BrowserTab">
                                    <Grid Height="36" ColumnSpacing="8" Opacity="{x:Bind TabOpacity, Mode=OneWay}"
                                          HorizontalAlignment="{x:Bind IconAlignment, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Initial, Mode=OneWay}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{x:Bind Favicon, Mode=OneWay}"
                                                   Width="16"
                                                   Height="16"
                                                   Stretch="Uniform"
                                                   Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                            <ProgressRing Width="16" Height="16"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                          IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                                          Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                                            <Button Width="18" Height="18"
                                                    MinWidth="0" MinHeight="0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="TabAudioButton_Click"
                                                    Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                    ToolTipService.ToolTip="静音/取消静音">
                                                <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}"
                                                          FontSize="11"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Title, Mode=OneWay}"
                                                   Visibility="{x:Bind TitleVisibility, Mode=OneWay}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Border Grid.Column="2"
                                                Canvas.ZIndex="20"
                                                Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Right"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                Tag="{x:Bind Id}"
                                                Tapped="CloseTabIcon_Tapped"
                                                ToolTipService.ToolTip="关闭标签页">
                                            <FontIcon Glyph="&#xE711;" FontSize="10"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                      FontFamily="Segoe Fluent Icons" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ItemsControl x:Name="VerticalIconTabList"
                                      Grid.Row="1"
                                      Margin="4,0,0,0"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{x:Bind Tabs}"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel HorizontalAlignment="Left" Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:BrowserTab">
                                    <Button Width="40" Height="38"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="6"
                                            Tag="{x:Bind Id}"
                                            Click="IconTab_Click"
                                            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                        <Grid Width="40" Height="38">
                                            <Grid Width="18" Height="18"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4"
                                                    Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Initial, Mode=OneWay}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{x:Bind Favicon, Mode=OneWay}"
                                                       Width="16" Height="16" Stretch="Uniform"
                                                       Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                                <ProgressRing Width="16" Height="16"
                                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                              IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                                              Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                                            <Button Width="18" Height="18"
                                                    MinWidth="0" MinHeight="0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="TabAudioButton_Click"
                                                    Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                    ToolTipService.ToolTip="静音/取消静音">
                                                <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}"
                                                          FontSize="11"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Button>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid x:Name="VerticalTabFooter"
                              Grid.Row="2"
                              Margin="4,4,4,8"
                              ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="VerticalTabLayoutFooterButton"
                                    Grid.Column="0"
                                    Width="22" Height="30"
                                    Padding="0"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="TabLayoutMenu_Click"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="标签页布局和本次记录">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" FontFamily="Segoe Fluent Icons" />
                            </Button>
                            <Button x:Name="VerticalNewTabButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Height="30"
                                    Padding="0"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Click="NewTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="6">
                                <StackPanel x:Name="VerticalNewTabContent"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="8,0,8,0">
                                    <FontIcon Glyph="&#xE710;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="VerticalNewTabLabel" Text="新建标签页"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Horizontal tab strip; hidden in vertical tab mode. -->
                    <Grid x:Name="VerticalWindowTitleBar"
                          Grid.Row="0"
                          Height="40"
                          Background="Transparent"
                          Visibility="Collapsed">
                        <TextBlock Text="EXET"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Grid>
                    <Grid x:Name="HorizontalTabStrip"
                          Grid.Row="0"
                          Height="40"
                          SizeChanged="HorizontalTabStrip_SizeChanged"
                          Background="Transparent"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TitleBarDragSurface"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Width="0"
                                Background="Transparent" />

                        <Button x:Name="HorizontalTabLayoutButton"
                                Grid.Column="0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="34" Height="34"
                                Margin="4,0,2,0"
                                Click="TabLayoutMenu_Click"
                                ToolTipService.ToolTip="标签页布局和本次记录">
                            <FontIcon Glyph="&#xE70D;" FontSize="13" FontFamily="Segoe Fluent Icons" />
                        </Button>

                        <ListView x:Name="HorizontalTabList"
                                  Grid.Column="1"
                                  Margin="0,-3,142,0"
                                  ItemsSource="{x:Bind Tabs}"
                                  SelectionMode="Single"
                                  UseSystemFocusVisuals="False"
                                  IsItemClickEnabled="True"
                                  SelectionChanged="HorizontalTabList_SelectionChanged"
                                  ItemClick="HorizontalTabList_ItemClick"
                                  SizeChanged="HorizontalTabList_SizeChanged"
                                  Background="{x:Null}"
                                  BorderThickness="0"
                                  Padding="4,0,48,0"
                                  ItemContainerStyle="{StaticResource HorizontalTabItemStyle}"
                                  ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemFocusVisualPrimaryBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemFocusVisualSecondaryBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                            </ListView.Resources>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:BrowserTab">
                                    <Grid Height="32" Width="{x:Bind HorizontalTabWidth, Mode=OneWay}" Padding="{x:Bind HorizontalPadding, Mode=OneWay}" ColumnSpacing="{x:Bind HorizontalColumnSpacing, Mode=OneWay}" Opacity="{x:Bind TabOpacity, Mode=OneWay}">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{x:Bind IconVisibility, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Initial, Mode=OneWay}"
                                                           FontSize="8"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{x:Bind Favicon, Mode=OneWay}"
                                                   Width="15"
                                                   Height="15"
                                                   Stretch="Uniform"
                                                   Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                                            <ProgressRing Width="15" Height="15"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                          IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                                          Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                                            <Button Width="18" Height="18"
                                                    MinWidth="0" MinHeight="0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Click="TabAudioButton_Click"
                                                    Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                    ToolTipService.ToolTip="静音/取消静音">
                                                <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}"
                                                          FontSize="11"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Title, Mode=OneWay}"
                                                   Visibility="{x:Bind TitleVisibility, Mode=OneWay}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Border Grid.Column="2"
                                                Canvas.ZIndex="20"
                                                Width="18"
                                                Height="18"
                                                CornerRadius="9"
                                                Margin="0,0,4,0"
                                                HorizontalAlignment="Right"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                Tag="{x:Bind Id}"
                                                Tapped="CloseTabIcon_Tapped"
                                                ToolTipService.ToolTip="关闭标签页">
                                            <FontIcon Glyph="&#xE711;" FontSize="10"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                      FontFamily="Segoe Fluent Icons" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button x:Name="HorizontalTabScrollLeftButton"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="24" Height="32"
                                Margin="2,4,0,4"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Visibility="Collapsed"
                                Click="HorizontalTabScrollLeft_Click">
                            <FontIcon Glyph="&#xE76B;" FontSize="10" FontFamily="Segoe Fluent Icons" />
                        </Button>
                        <Button x:Name="HorizontalTabScrollRightButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="24" Height="32"
                                Margin="0,4,2,4"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Visibility="Collapsed"
                                Click="HorizontalTabScrollRight_Click">
                            <FontIcon Glyph="&#xE76C;" FontSize="10" FontFamily="Segoe Fluent Icons" />
                        </Button>

                        <Button x:Name="HorizontalNewTabButton"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="36"
                                Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Canvas.ZIndex="11"
                                Click="NewTab_Click"
                                ToolTipService.ToolTip="新建标签页">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="HorizontalNewTabTransform" />
                            </Button.RenderTransform>
                            <FontIcon Glyph="&#xE710;" FontSize="13" FontFamily="Segoe Fluent Icons" />
                        </Button>
                    </Grid>

                    <!-- Command bar -->
                    <Grid x:Name="ToolbarRow"
                          Grid.Row="1"
                          Height="52"
                          Padding="4,0,8,0"
                          ColumnSpacing="2"
                          Background="Transparent">
                        <Grid.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1F1F70B8" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#331F70B8" />
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                                                <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource ToolbarButtonStyle}"
                                Click="BackButton_Click" ToolTipService.ToolTip="后退 (Alt+左箭头)">
                            <FontIcon Glyph="&#xE72B;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>
                        <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}"
                                Click="ForwardButton_Click" ToolTipService.ToolTip="前进 (Alt+右箭头)">
                            <FontIcon Glyph="&#xE72A;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>
                        <Button x:Name="ReloadButton" Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}"
                                Click="ReloadButton_Click" ToolTipService.ToolTip="刷新 (F5)">
                            <FontIcon Glyph="&#xE72C;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>
                        <Button x:Name="HomeButton" Grid.Column="3" Style="{StaticResource ToolbarButtonStyle}"
                                Click="HomeButton_Click" ToolTipService.ToolTip="新建标签页 (Alt+Home)">
                            <FontIcon Glyph="&#xE80F;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>

                        <Grid Grid.Column="4" Margin="4,0" VerticalAlignment="Center">
                            <Border x:Name="AddressFocusRing"
                                    CornerRadius="20"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    Margin="-2"
                                    IsHitTestVisible="False" />
                            <Border x:Name="AddressPill"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE721;"
                                          FontSize="14"
                                          FontFamily="Segoe Fluent Icons"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />
                                <TextBox x:Name="AddressBox"
                                         Grid.Column="1"
                                         Height="24"
                                         MinHeight="0"
                                         Padding="0,0,2,0"
                                         Margin="0,6,0,0"
                                         BorderThickness="0"
                                         Background="Transparent" PlaceholderText="搜索网页或输入网址"
                                         FontSize="14"
                                         FontWeight="Normal"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         UseSystemFocusVisuals="False"
                                         FocusVisualPrimaryThickness="0"
                                         FocusVisualSecondaryThickness="0"
