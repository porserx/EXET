                                                  Height="16"
                                                  IsActive="False"
                                                  Visibility="Collapsed"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>

                        <Button x:Name="FavoriteButton" Grid.Column="5" Style="{StaticResource ToolbarButtonStyle}"
