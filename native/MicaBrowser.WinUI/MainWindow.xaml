                                               Text="0"
                                               FontSize="8"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="PasswordsButton" Grid.Column="7" Style="{StaticResource ToolbarButtonStyle}"
