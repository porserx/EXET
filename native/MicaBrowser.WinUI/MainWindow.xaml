                            <FontIcon Glyph="&#xE192;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>

                        <Button x:Name="FavoritesButton" Grid.Column="8" Style="{StaticResource ToolbarButtonStyle}"
                                Click="FavoritesButton_Click" ToolTipService.ToolTip="收藏夹">
                            <FontIcon Glyph="&#xE728;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>

                        <Button x:Name="HistoryButton" Grid.Column="9" Style="{StaticResource ToolbarButtonStyle}"
                                Click="HistoryButton_Click" ToolTipService.ToolTip="历史记录">
                            <FontIcon Glyph="&#xE81C;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>

                        <Button x:Name="ExtensionsButton" Grid.Column="10" Style="{StaticResource ToolbarButtonStyle}"
                                Click="ExtensionsButton_Click" ToolTipService.ToolTip="扩展">
                            <FontIcon Glyph="&#xE8F1;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>

                        <Button x:Name="DownloadsButton" Grid.Column="11" Style="{StaticResource ToolbarButtonStyle}"
                                Click="DownloadsButton_Click" ToolTipService.ToolTip="下载内容 (Ctrl+J)">
                            <FontIcon Glyph="&#xE896;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>


                        <Button x:Name="ToolbarExpandButton" Grid.Column="12" Style="{StaticResource ToolbarButtonStyle}"
                                Click="ToolbarExpandButton_Click"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="展开隐藏的工具栏按钮"
                                AutomationProperties.Name="展开隐藏的工具栏按钮">
                            <FontIcon x:Name="ToolbarExpandIcon" Glyph="&#xE70D;" FontSize="13" FontFamily="Segoe Fluent Icons" />
                        </Button>

                        <Button x:Name="MenuButton" Grid.Column="13" Style="{StaticResource ToolbarButtonStyle}"
                                Click="MenuButton_Click" ToolTipService.ToolTip="设置及其他">
                            <FontIcon Glyph="&#xE712;" FontSize="15" FontFamily="Segoe Fluent Icons" />
                        </Button>
                        
                                            <Border x:Name="ZoomOverlay"
                                Grid.ColumnSpan="14"
                                Canvas.ZIndex="200"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,52,0"
                                Padding="8,5"
                                CornerRadius="9"
                                Visibility="Collapsed"
                                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ZoomOverlayTransform" />
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button x:Name="ZoomOutOverlayButton"
                                        Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                                        Click="ZoomOutOverlayButton_Click"
                                        ToolTipService.ToolTip="缩小">
                                    <FontIcon Glyph="&#xE738;" FontSize="12" FontFamily="Segoe Fluent Icons" />
                                </Button>
                                <TextBlock x:Name="ZoomOverlayText"
                                           Text="100%"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           MinWidth="48"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ZoomInOverlayButton"
                                        Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                                        Click="ZoomInOverlayButton_Click"
                                        ToolTipService.ToolTip="放大">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" FontFamily="Segoe Fluent Icons" />
                                </Button>
                            </StackPanel>
                        </Border>
</Grid>

                    <!-- Web content and the right side panel -->
                    <Grid x:Name="ContentShell" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="BrowserHost"
                              Grid.Column="0"
                              Background="Transparent"
                              SizeChanged="BrowserHost_SizeChanged" />

                        <Border x:Name="SidebarDismissLayer"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Background="#01000000"
                                Visibility="Collapsed"
                                Tapped="SidebarDismissLayer_Tapped" />

                        <Border x:Name="SidebarPane"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Right"
                                Width="320"
                                Height="480"
                                VerticalAlignment="Top"
                                Margin="0,6,8,0"
                                CornerRadius="22"
                                Visibility="Collapsed"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                Opacity="0"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1A7A7A7A" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#307A7A7A" />
                            </Border.Resources>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SidebarTransform" X="0" />
                            </Border.RenderTransform>
                            <Grid x:Name="SidebarContentRoot">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="SidebarContentTransform" Y="0" />
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="54" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Padding="18,0,8,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SidebarTitle"
                                               Grid.Column="0"
                                               Text="收藏夹"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,4,0"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                        <Button x:Name="SidebarAddFavoriteButton" Style="{StaticResource ToolbarButtonStyle}"
                                                Width="34" Height="34" Visibility="Collapsed"
                                                Click="SidebarAddFavorite_Click" ToolTipService.ToolTip="收藏当前页面">
                                            <FontIcon Glyph="&#xE734;" FontSize="14" FontFamily="Segoe Fluent Icons" />
                                        </Button>
                                        <Button x:Name="SidebarNewFolderButton" Style="{StaticResource ToolbarButtonStyle}"
                                                Width="34" Height="34" Visibility="Collapsed"
                                                Click="SidebarNewFolder_Click" ToolTipService.ToolTip="新建收藏夹">
                                            <FontIcon Glyph="&#xE8F4;" FontSize="14" FontFamily="Segoe Fluent Icons" />
                                        </Button>
                                        <Button x:Name="SidebarTrashButton" Style="{StaticResource ToolbarButtonStyle}"
                                                Width="34" Height="34" Visibility="Collapsed"
                                                Click="SidebarTrash_Click" ToolTipService.ToolTip="清除历史记录">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" FontFamily="Segoe Fluent Icons" />
                                        </Button>
                                        <Button x:Name="SidebarSearchButton" Style="{StaticResource ToolbarButtonStyle}"
                                                Width="34" Height="34" Click="SidebarSearch_Click"
                                                ToolTipService.ToolTip="搜索">
                                            <FontIcon Glyph="&#xE721;" FontSize="14" FontFamily="Segoe Fluent Icons" />
                                        </Button>
                                        <Button x:Name="SidebarMoreButton" Style="{StaticResource ToolbarButtonStyle}"
                                                Width="34" Height="34" Click="SidebarMore_Click"
                                                ToolTipService.ToolTip="更多">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" FontFamily="Segoe Fluent Icons" />
                                        </Button>
                                        <Button x:Name="SidebarPinButton" Style="{StaticResource ToolbarButtonStyle}"
                                                Width="34" Height="34" Click="SidebarPin_Click"
                                                ToolTipService.ToolTip="固定为侧栏">
                                            <FontIcon x:Name="SidebarPinIcon" Glyph="&#xE840;" FontSize="14" FontFamily="Segoe Fluent Icons" />
                                        </Button>
                                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                                Width="34" Height="34" Click="CloseSidebar_Click"
                                                ToolTipService.ToolTip="关闭侧栏">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" FontFamily="Segoe Fluent Icons" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <StackPanel x:Name="FavoriteFoldersChrome" Visibility="Collapsed"
                                                Padding="10,8" Spacing="6">
                                        <Button x:Name="FavoriteBackButton" Content="←  返回上一级"
                                                FontSize="14" FontWeight="SemiBold"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                BorderThickness="0" CornerRadius="8"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="12,9,12,9" MinHeight="38"
                                                Margin="0,2,0,6"
                                                Visibility="Collapsed" Click="FavoriteBack_Click" />
                                        <StackPanel x:Name="FavoriteFoldersPanel" Spacing="4" />
                                    </StackPanel>

                                    <ListView x:Name="FavoritesList"
                                              ItemsSource="{x:Bind Favorites}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="FavoritesList_ItemClick"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="6"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:FavoriteEntry">
                                                <Grid Height="46" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="6"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <TextBlock Text="★"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Folder}" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource TabCloseButtonStyle}"
                                                            Tag="{x:Bind Url}"
                                                            Click="RemoveFavorite_Click"
                                                            ToolTipService.ToolTip="移除收藏">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" FontFamily="Segoe Fluent Icons" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <StackPanel x:Name="HistoryChrome" Visibility="Collapsed" Padding="10,2,10,0" Spacing="10">
                                        <TextBox x:Name="HistorySearchBox" PlaceholderText="搜索历史记录"
                                                 Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
                                                 BorderThickness="0" CornerRadius="8" Height="34"
                                                 MinHeight="0" Padding="10,0,10,0"
                                                 VerticalContentAlignment="Center"
                                                 VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <StackPanel.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3D2F6FBF" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#662F6FBF" />
                                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            </StackPanel.Resources>
                                            <Button x:Name="HistoryAllTab" Content="全部" FontSize="13" FontWeight="SemiBold"
                                                    Background="#2E2F6FBF" BorderThickness="0" CornerRadius="6"
                                                    Padding="12,5,12,5" />
                                            <Button x:Name="HistoryRecentTab" Content="最近关闭" FontSize="13"
                                                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                    Padding="12,5,12,5" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="HistoryGroupedPanel" Visibility="Collapsed"
                                                Margin="0,92,0,0" Padding="8,0,8,8" Spacing="2" />
                                    <ListView x:Name="HistoryList"
                                              ItemsSource="{x:Bind History}"
                                              Visibility="Collapsed"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="HistoryList_ItemClick"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="6"
                                              Margin="0,92,0,0"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:HistoryEntry">
                                                <Grid Height="40" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE81C;" FontSize="15"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="1"
                                                                Margin="0,1,0,0">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Host}" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind VisitedText}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="0,1,0,0"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource TabCloseButtonStyle}"
                                                            Tag="{x:Bind Url}"
                                                            Click="RemoveHistory_Click"
                                                            ToolTipService.ToolTip="删除记录">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" FontFamily="Segoe Fluent Icons" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <ListView x:Name="DownloadsList"
                                              ItemsSource="{x:Bind Downloads}"
                                              Visibility="Collapsed"
                                              SelectionMode="None"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="8"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:DownloadItem">
                                                <Border Padding="12,10"
                                                        Margin="0,0,0,6"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Grid RowSpacing="6">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind FileName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                        </Grid>
                                                        <ProgressBar Grid.Row="1" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Height="3" />
                                                        <Grid Grid.Row="2" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind State, Mode=OneWay}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Button Grid.Column="1" Content="预览" FontSize="11" Height="26" Padding="10,0"
                                                                    Visibility="{x:Bind PdfVisibility}"
                                                                    Tag="{x:Bind FilePath}" Click="PreviewDownload_Click" />
                                                            <Button Grid.Column="2" Content="打开" FontSize="11" Height="26" Padding="10,0"
                                                                    Tag="{x:Bind FilePath}" Click="OpenDownload_Click" />
                                                            <Button Grid.Column="3" Content="打开位置" FontSize="11" Height="26" Padding="10,0"
                                                                    Tag="{x:Bind FilePath}" Click="RevealDownload_Click"
                                                                    ToolTipService.ToolTip="在资源管理器中显示" />
                                                            <Button Grid.Column="4" Content="取消" FontSize="11" Height="26" Padding="10,0"
                                                                    Tag="{x:Bind FilePath}" Click="CancelDownload_Click"
                                                                    Visibility="{x:Bind CancelVisibility, Mode=OneWay}" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>

                    <Grid x:Name="StatusBar"
