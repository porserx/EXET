<Window
    x:Class="MicaBrowser.TaskManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MicaBrowser.Models"
    Title="浏览器任务管理器 - EXET">

    <Grid x:Name="RootGrid" Padding="20"
          UseLayoutRounding="True"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="3">
            <TextBlock Text="浏览器任务管理器" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="显示 EXET 与 WebView2 子进程的实时 CPU 和内存占用。"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Name="SummaryText" Grid.Row="1" Margin="0,14,0,14"
                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="2" Padding="10,0,10,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="名称" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Grid.Column="1" Text="类型" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Grid.Column="2" Text="CPU" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Grid.Column="3" Text="内存" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Grid.Column="4" Text="PID" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <ListView x:Name="TasksList"
                  Grid.Row="3"
                  SelectionMode="None"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="4">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:BrowserTaskItem">
                    <Grid Padding="10,7" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" FontSize="10"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Kind}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Cpu, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Memory, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind ProcessId}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
